# Build configuration for Android build-tools aarch64
# Modify these values to target different versions

# AOSP source tag/branch to build from
# For build-tools 33.0.1, use: platform-tools-33.0.1
# For build-tools 33.0.0, use: android-13.0.0_r1
# For build-tools 34.0.0, use: android-14.0.0_r1
AOSP_BRANCH=platform-tools-33.0.1

# Label for the output artifacts
BUILD_TOOLS_LABEL=33.0.1

# Tools to build
TARGETS=aapt aapt2 aidl zipalign dexdump split-select

# Parallel build jobs (default: nproc)
JOBS=4

# ccache directory
CCACHE_DIR=./.ccache
